# Base de données (requis)
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASS=
DB_NAME=

# JWT (requis)
JWT_SECRET=

# Stockage local (chemin absolu recommandé en production)
# STORAGE_ROOT=/app/storage

# Nœud de synchronisation (LOCAL = vérité, CLOUD = miroir)
# NODE_ID=CLOUD
# SYNC_API_KEY=same-key-on-local-and-cloud

# Google Cloud Storage (prioritaire)
# GCS_BUCKET=shekinah-schoolmatrix-assets
# GCS_PREFIX=schoolmatrix
# GCS_PROJECT_ID=shekinah-schoolmatrix
# GOOGLE_APPLICATION_CREDENTIALS=  # optionnel hors VM GCP

# Import PDF anciens élèves (IA)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# S3 (legacy, désactivé — ne plus utiliser)
# AWS_REGION=
# AWS_S3_BUCKET=
# AWS_S3_PREFIX=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# NODE_ENV=production utilise .env.prod
# Copier vers .env.prod et remplir les valeurs.
#
# En production locale Docker (docker-compose.prod-local.yml) :
# Placer ce fichier dans le dossier racine des données (ex. C:\SchoolMatrix\.env.prod)
# et définir DB_HOST=db, DB_PORT=5432 (les autres DB_* comme dans le .env du projet).
