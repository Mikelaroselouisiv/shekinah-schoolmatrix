# Miroir cloud LOCAL (lab sync) — copier vers .env.dev.cloud
# Postgres : shekinah-db-cloud-dev (dev/docker-compose.sync-cloud.yml)
# Ne jamais pointer ce fichier vers la VM GCP.

NODE_ENV=development
PORT=3001
ENV_FILE=.env.dev.cloud

DB_HOST=localhost
DB_PORT=5437
DB_USER=schooluser
DB_PASS=schoolpass
DB_NAME=schoolmatrix

JWT_SECRET=your-secret-key-change-in-production

STORAGE_ROOT=./storage

NODE_ID=CLOUD
SYNC_API_KEY=shekinah-dev-sync-lab
# Pas de SYNC_KICK_URL : le cloud est miroir, l’agent vit côté LOCAL.
