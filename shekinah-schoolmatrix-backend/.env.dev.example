# Copier vers .env.dev — utilisé uniquement quand NODE_ENV=development
# Postgres DEV : conteneur shekinah-db-dev (voir dev/docker-compose.postgres.yml)

NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5436
DB_USER=schooluser
DB_PASS=schoolpass
DB_NAME=schoolmatrix

# JWT (requis)
JWT_SECRET=your-secret-key-change-in-production

# Stockage local (défaut: ./storage)
# STORAGE_ROOT=./storage

# Sync lab LOCAL (miroir :3001) — PAS la VM GCP
NODE_ID=LOCAL
SYNC_API_KEY=shekinah-dev-sync-lab
SYNC_KICK_URL=http://127.0.0.1:3911/kick

# Google Cloud Storage (optionnel en DEV)
# GCS_BUCKET=shekinah-schoolmatrix-assets
# GCS_PREFIX=schoolmatrix
# GCS_PROJECT_ID=shekinah-schoolmatrix

# Import anciens élèves (PDF) via IA — Gemini recommandé (lit aussi les scans)
# GEMINI_API_KEY=votre_cle_https://aistudio.google.com/apikey
# GEMINI_MODEL=gemini-3.6-flash
# OPENAI_API_KEY=  # secours (texte PDF seulement)

