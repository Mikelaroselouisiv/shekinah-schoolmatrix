{
  "name": "shekinah-schoolmatrix-desktop",
  "productName": "Shekinah SchoolMatrix",
  "description": "Application desktop SchoolMatrix (Server / Remote)",
  "author": "Shekinah SchoolMatrix",
  "private": true,
  "version": "4.0.8",
  "main": "src/main/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 VITE_APP_EDITION=server electron .",
    "dev:remote": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron:remote\"",
    "dev:electron:remote": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 VITE_APP_EDITION=remote electron .",
    "dev:mirror": "concurrently -k \"npm:dev:renderer:mirror\" \"npm:dev:electron:mirror\"",
    "dev:renderer:mirror": "cross-env VITE_DEV_PORT=5174 VITE_API_URL=http://127.0.0.1:3001 vite",
    "dev:electron:mirror": "wait-on tcp:5174 && cross-env VITE_DEV_SERVER_URL=http://localhost:5174 VITE_APP_EDITION=remote SCHOOLMATRIX_API_BASE=http://127.0.0.1:3001 electron .",
    "dev:remote:lab": "npm run dev:mirror",
    "dev:electron:remote:lab": "npm run dev:electron:mirror",
    "start": "electron .",
    "build": "vite build",
    "prepare:server-stack": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/prepare-server-stack.ps1",
    "dist:win:remote": "cross-env VITE_APP_EDITION=remote npm run build && cross-env VITE_APP_EDITION=remote CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config electron-builder.remote.json --win --x64 --publish never",
    "dist:win:server": "npm run prepare:server-stack && cross-env VITE_APP_EDITION=server npm run build && cross-env VITE_APP_EDITION=server CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config electron-builder.server.json --win --x64 --publish never",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "electron-updater": "^6.8.3",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.13.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.0.3",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^2.1.8",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.shekinah.schoolmatrix.desktop",
    "productName": "Shekinah SchoolMatrix",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "forceCodeSigning": false,
      "signExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
