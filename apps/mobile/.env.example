# URL API Nest (défaut cloud Shekinah si non défini)
# EXPO_PUBLIC_API_BASE_URL=http://34.118.138.96

# Ou bascule rapide cloud | local
# EXPO_PUBLIC_API_TARGET=cloud
# EXPO_PUBLIC_API_TARGET=local

# Simulateur Android → Nest local sur la machine hôte :
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000

# Appareil physique → IP LAN du Mac :
# EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:3000
