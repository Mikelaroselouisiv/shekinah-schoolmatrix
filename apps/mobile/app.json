{
  "expo": {
    "name": "Shekinah",
    "slug": "shekinah-schoolmatrix-mobile",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F3F1"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shekinah.schoolmatrix",
      "buildNumber": "6",
      "appleTeamId": "P227YQ54ZL",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "34.118.138.96": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": true,
              "NSExceptionRequiresForwardSecrecy": false
            },
            "localhost": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": true
            }
          }
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5F3F1",
        "foregroundImage": "./assets/logo.png"
      },
      "package": "com.shekinah.schoolmatrix",
      "versionCode": 5,
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "./plugins/withCleartextTraffic",
      "./plugins/withAndroidApkInstall",
      "./plugins/withEmbedExpoModulesJSI",
      "expo-file-system",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Shekinah utilise vos photos pour les fiches élèves.",
          "cameraPermission": "Shekinah utilise la caméra pour photographier les élèves."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logo.png",
          "color": "#B85A48",
          "defaultChannel": "birthdays"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "a0014c42-75b1-4542-a1a9-042b1f2bd75b"
      }
    },
    "owner": "larosemike"
  }
}
