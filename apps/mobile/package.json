{
  "name": "schoolmatrix-mobile",
  "version": "1.0.4",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^7.18.16",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "axios": "^1.19.0",
    "expo": "~57.0.12",
    "expo-application": "~57.0.2",
    "expo-constants": "~57.0.10",
    "expo-file-system": "~57.0.4",
    "expo-image-picker": "~57.0.9",
    "expo-intent-launcher": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-network": "~57.0.1",
    "expo-notifications": "^0.32.17",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "start:fresh": "bash scripts/fresh-start.sh start",
    "android": "expo run:android",
    "android:fresh": "bash scripts/fresh-start.sh android",
    "ios": "expo run:ios",
    "ios:fresh": "bash scripts/fresh-start.sh ios",
    "dev:mobile": "expo start",
    "dev:mobile:fresh": "bash scripts/fresh-start.sh start",
    "dev:mobile:android:fresh": "bash scripts/fresh-start.sh android",
    "dev:mobile:ios:fresh": "bash scripts/fresh-start.sh ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit"
  },
  "expo": {
    "autolinking": {
      "ios": {
        "exclude": [
          "expo-file-system",
          "expo-intent-launcher"
        ]
      }
    }
  },
  "private": true
}
