# Copié sur la VM dans /opt/schoolmatrix/.env.prod (ne jamais committer les vraies valeurs).
# Généré / mis à jour par infra/scripts/gcp-provision-env.ps1

DB_USER=schoolmatrix
DB_PASS=CHANGE_ME_STRONG_PASSWORD
DB_NAME=schoolmatrix
JWT_SECRET=CHANGE_ME_JWT_SECRET
NODE_ID=CLOUD
STORAGE_ROOT=/app/storage
SYNC_API_KEY=CHANGE_ME_SYNC_KEY_LONGUE

# Google Cloud Storage (fichiers)
GCS_BUCKET=shekinah-schoolmatrix-assets
GCS_PREFIX=schoolmatrix
GCS_PROJECT_ID=shekinah-schoolmatrix
